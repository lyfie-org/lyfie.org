{
  "name": "lyfie-org",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "description": "Vite + React website for Lyfie.org",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm wrangler deploy",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyfie-org/lyfie.org.git"
  },
  "keywords": [
    "lyfie",
    "nextjs",
    "boilerplate"
  ],
  "author": "Lyfie Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lyfie-org/lyfie.org/issues"
  },
  "homepage": "https://lyfie.org",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.11",
    "wrangler": "^4.72.0"
  }
}
