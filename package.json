{
  "name": "lyfie-org",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "description": "Barebones homepage boilerplate for Lyfie.org",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyfie-org/lyfie.org.git"
  },
  "keywords": ["lyfie", "nextjs", "boilerplate"],
  "author": "Lyfie Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lyfie-org/lyfie.org/issues"
  },
  "homepage": "https://lyfie.org",
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
