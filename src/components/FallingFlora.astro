---
// Lyfie's signature: a few sakura petals and leaves drifting through the hero.
//
// Ported from the old React component, but calmer: ten particles instead of 28,
// slower, confined to the hero band (the parent must be position: relative), and
// randomised at BUILD time with a seeded generator — so it ships zero JavaScript
// and the markup is identical on every build. Colours come from tokens, so the
// petals re-tint with the theme. Hidden entirely under prefers-reduced-motion.

interface Props {
  count?: number;
  seed?: number;
}

const { count = 10, seed = 20260927 } = Astro.props;

// mulberry32: tiny deterministic PRNG.
let state = seed;
const random = () => {
  state = (state + 0x6d2b79f5) | 0;
  let t = Math.imul(state ^ (state >>> 15), 1 | state);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rand = (min: number, max: number) => random() * (max - min) + min;
const pick = <T,>(items: readonly T[]): T => items[Math.floor(random() * items.length)]!;

const PETAL_COLORS = [
  "var(--accent)",
  "var(--accent-hover)",
  "color-mix(in srgb, var(--accent) 55%, var(--surface))"
] as const;
const LEAF_COLORS = [
  "var(--leaf)",
  "color-mix(in srgb, var(--leaf) 60%, var(--surface))"
] as const;

const particles = Array.from({ length: count }, () => {
  const kind = random() < 0.65 ? "petal" : "leaf";
  const duration = rand(30, 45);
  const x0 = rand(-5, 95);
  const rotate = rand(-40, 40);
  return {
    kind,
    variant: Math.floor(rand(0, 3)),
    color: kind === "leaf" ? pick(LEAF_COLORS) : pick(PETAL_COLORS),
    style: [
      `--x0: ${x0.toFixed(1)}cqw`,
      `--x1: ${(x0 + rand(12, 30)).toFixed(1)}cqw`,
      `--r0: ${rotate.toFixed(0)}deg`,
      `--r1: ${(rotate + rand(120, 300)).toFixed(0)}deg`,
      `--duration: ${duration.toFixed(1)}s`,
      `--delay: ${(-rand(0, duration)).toFixed(1)}s`,
      `--sway: ${rand(4, 8).toFixed(1)}s`,
      `--drift: ${rand(6, 20).toFixed(0)}px`,
      `--size: ${(kind === "leaf" ? rand(14, 24) : rand(10, 20)).toFixed(0)}px`,
      `--opacity: ${rand(0.45, 0.7).toFixed(2)}`
    ].join("; ")
  };
});

const PETALS = [
  "M16 3C21 3 28 10 28 15C28 22 21 28 16 29C11 28 4 22 4 15C4 10 11 3 16 3Z",
  "M16 3C21 3 25 8 25 14C25 20 20 27 16 29C12 27 7 20 7 14C7 8 11 3 16 3Z",
  "M16 4C20 4 24 8 24 13C24 18 20 24 16 28C12 24 8 18 8 13C8 8 12 4 16 4Z"
] as const;
const LEAVES = [
  {
    body: "M3 20C4 11 11 5 20 5C25 5 29 7 29 7C29 7 27 11 24 17C22 22 18 26 11 27C7 27 4 24 3 20Z",
    vein: "M8 23C15 17 19 13 26 8M13 26C13 21 14 18 16 15"
  },
  {
    body: "M4 19C4 10 11 4 20 4H28V12C28 21 21 28 12 28H4V19Z",
    vein: "M7 24L24 8M13 27L27 13"
  },
  {
    body: "M16 2C22 7 26 13 26 20C26 25 22 29 16 30C10 29 6 25 6 20C6 13 10 7 16 2Z",
    vein: "M16 6V27M16 13C12 16 10 19 9 22M16 13C20 16 22 19 23 22"
  }
] as const;
---

<div class="flora" aria-hidden="true">
  {particles.map((p) => (
    <span class="flora__particle" style={p.style}>
      <span class="flora__sway">
        <svg viewBox="0 0 32 32" focusable="false">
          {p.kind === "petal" ? (
            <path d={PETALS[p.variant]} fill={p.color} />
          ) : (
            <>
              <path d={LEAVES[p.variant]!.body} fill={p.color} />
              <path
                d={LEAVES[p.variant]!.vein}
                stroke="currentColor"
                stroke-opacity="0.22"
                stroke-width="1.2"
                stroke-linecap="round"
                fill="none"
              />
            </>
          )}
        </svg>
      </span>
    </span>
  ))}
</div>

<style>
  .flora {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* Particles travel in container units, so the fall spans the hero exactly. */
    container-type: size;
    color: var(--text-h);
    /* Fade in/out at the band's edges instead of popping at a hard line. */
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 80%, transparent);
  }

  .flora__particle {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--size);
    height: var(--size);
    opacity: 0;
    animation: flora-fall var(--duration) linear infinite;
    animation-delay: var(--delay);
    will-change: transform, opacity;
  }

  .flora__sway {
    display: block;
    width: 100%;
    height: 100%;
    animation: flora-sway var(--sway) ease-in-out infinite alternate;
  }

  .flora__sway svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes flora-fall {
    0% {
      opacity: 0;
      transform: translate3d(var(--x0), -10cqh, 0) rotate(var(--r0));
    }
    10%,
    85% {
      opacity: var(--opacity);
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--x1), 105cqh, 0) rotate(var(--r1));
    }
  }

  @keyframes flora-sway {
    from {
      translate: calc(var(--drift) * -1) 0;
    }
    to {
      translate: var(--drift) 0;
    }
  }

  @media (max-width: 45rem) {
    .flora__particle:nth-child(n + 6) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flora {
      display: none;
    }
  }
</style>
