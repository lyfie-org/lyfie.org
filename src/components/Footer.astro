---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import {
  CREATOR_GITHUB_URL,
  CREATOR_NAME,
  CREATOR_URL,
  GITHUB_ORG_URL,
  LUTHOR_URL,
  PAPYRA_URL,
  SPONSORS_URL,
  X_URL,
  SITE_NAME
} from "../data/site";

const year = new Date().getFullYear();
// Only projects with a page of their own; teasers live on the home page.
const projects = (await getCollection("projects", (p) => p.data.page)).sort(
  (a, b) => a.data.order - b.data.order
);

type Link = { href: string; label: string; external?: boolean };

const columns: { title: string; links: Link[] }[] = [
  {
    title: "Projects",
    links: [
      ...projects.map((p) => ({ href: `/projects/${p.id}/`, label: p.data.name })),
      { href: "/projects/", label: "All projects" }
    ]
  },
  {
    title: "Organisation",
    links: [
      { href: "/manifesto/", label: "Manifesto" },
      { href: "/changelog/", label: "Changelog" },
      { href: "/contribute/", label: "Contribute" }
    ]
  },
  {
    title: "Elsewhere",
    links: [
      { href: LUTHOR_URL, label: "luthor.fyi", external: true },
      { href: PAPYRA_URL, label: "papyra.app", external: true },
      { href: GITHUB_ORG_URL, label: "GitHub", external: true },
      { href: SPONSORS_URL, label: "GitHub Sponsors", external: true },
      { href: X_URL, label: "X / Twitter", external: true }
    ]
  }
];
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__mark">lyfie</p>
      <p class="site-footer__blurb">
        Free, open-source software — libraries, apps and games — with no paywalls, no
        trackers and no lock-in.
      </p>
      <p class="site-footer__icons">
        <a
          href={GITHUB_ORG_URL}
          rel="noopener noreferrer"
          aria-label="Lyfie on GitHub"
          title="Lyfie on GitHub"
        >
          <Icon name="github" size={18} />
        </a>
        <a
          href={SPONSORS_URL}
          rel="noopener noreferrer"
          aria-label="Sponsor Lyfie"
          title="Sponsor Lyfie"
        >
          <Icon name="heart" size={16} />
        </a>
      </p>
    </div>

    {columns.map((col) => (
      <nav class="site-footer__col" aria-label={col.title}>
        <h2>{col.title}</h2>
        <ul>
          {col.links.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? "noopener noreferrer" : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="wrap site-footer__legal">
    <p class="site-footer__maker">
      <a
        class="site-footer__mark-img"
        href={CREATOR_URL}
        rel="noopener noreferrer"
        tabindex="-1"
      >
        <picture>
          <source
            srcset="/media/maker/rna-still.webp"
            media="(prefers-reduced-motion: reduce)"
          />
          <img
            src="/media/maker/rna.webp"
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
      <span>
        Made with <Icon name="heart" size={13} class="site-footer__heart" /> by{" "}
        <a href={CREATOR_URL} rel="noopener noreferrer">
          {CREATOR_NAME}
        </a>{" "}
        ·{" "}
        <a href={CREATOR_GITHUB_URL} rel="noopener noreferrer">
          GitHub
        </a>
      </span>
    </p>
    <p>
      © {year} {SITE_NAME} · Open source, always
    </p>
    <p>Claude is our copilot. Life’s too short to scroll through forums.</p>
    <p>Built and hosted without a single third-party request.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    padding-block: var(--space-10) var(--space-6);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1.4fr repeat(3, 1fr);
    align-items: start;
  }

  .site-footer__mark {
    font: 400 var(--fs-xl) / 1 var(--heading);
    color: var(--text-h);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-2);
  }

  .site-footer__blurb {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text);
    max-width: 32ch;
  }

  .site-footer__maker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-footer__mark-img {
    flex: none;
    border-radius: 50%;
  }

  .site-footer__mark-img img {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  .site-footer__maker :global(.site-footer__heart) {
    color: var(--accent-text);
    fill: currentColor;
    vertical-align: -2px;
  }

  .site-footer__legal a {
    color: inherit;
    text-decoration-color: var(--border-hover);
  }

  .site-footer__legal a:hover {
    color: var(--accent-text);
  }

  .site-footer__icons {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }

  .site-footer__icons a {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .site-footer__icons a:hover {
    border-color: var(--accent-border);
    color: var(--text-h);
  }

  .site-footer__col h2 {
    font: 500 var(--fs-xs) / 1 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-h);
    margin: 0 0 var(--space-3);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__col a {
    font-size: var(--fs-sm);
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__col a:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  /* Footnote: who made it and how, on the left; the fine print on the right. */
  .site-footer__legal {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .site-footer__legal p {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text);
  }

  .site-footer__legal p:nth-child(even) {
    text-align: end;
  }

  @media (max-width: 56rem) {
    .site-footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .site-footer__about {
      grid-column: 1 / -1;
    }

    .site-footer__legal {
      grid-template-columns: 1fr;
    }

    .site-footer__legal p:nth-child(even) {
      text-align: start;
    }
  }
</style>
