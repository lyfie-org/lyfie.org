---

<svg
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill="none"
  stroke={icon.filled ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icon.body}
/>
