---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import {
  CREATOR_NAME,
  CREATOR_URL,
  GITHUB_ORG_URL,
  GOOD_FIRST_ISSUES_URL,
  SPONSORS_URL
} from "../data/site";

const repos = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => p.data.repo);

const ways = [
  {
    icon: "github",
    title: "Write code",
    body: "Start with an issue labelled “good first issue”. Every repo has a README with setup steps, and small pull requests are always welcome.",
    href: GOOD_FIRST_ISSUES_URL,
    cta: "Find a first issue"
  },
  {
    icon: "book",
    title: "Improve the docs",
    body: "Docs are code too. If something confused you, it will confuse the next person — a clearer sentence is a real contribution.",
    href: GITHUB_ORG_URL,
    cta: "Browse the repos"
  },
  {
    icon: "terminal",
    title: "Report a bug",
    body: "Found something broken? Open an issue on the project's repo with what you did, what you expected and what happened.",
    href: GITHUB_ORG_URL,
    cta: "Open an issue"
  },
  {
    icon: "heart",
    title: "Sponsor",
    body: "Sponsorship pays for hosting and time, and keeps everything free for everyone else. It never buys private features.",
    href: SPONSORS_URL,
    cta: "GitHub Sponsors"
  },
  {
    icon: "star",
    title: "Spread the word",
    body: "Star a repo, write about a project, or tell one person who needs it. Open source grows by word of mouth.",
    href: GITHUB_ORG_URL,
    cta: "Star on GitHub"
  }
] as const;
---

<Base
  title="Contribute"
  description="How to help build Lyfie: code, docs, bug reports, sponsorship — or just telling someone about a project."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contribute</p>
      <h1>Help us build the future</h1>
      <p class="lede">
        Lyfie gets better with every person who shows up. You do not need to be an expert
        — you need to care about software people can own.
      </p>
    </div>
  </section>

  <section class="section body">
    <div class="wrap">
      <div class="grid ways">
        {ways.map((w) => (
          <a class="card way" href={w.href} rel="noopener noreferrer">
            <span class="card__icon">
              <Icon name={w.icon} size={22} />
            </span>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
            <span class="way__cta">
              {w.cta} <Icon name="arrow-right" size={14} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Where the code lives</p>
        <h2>Pick a repo</h2>
        <p>
          Every project is its own repository under{" "}
          <a href={GITHUB_ORG_URL} rel="noopener noreferrer">
            github.com/lyfie-org
          </a>
          . Each one documents how to run it locally and how to send a change.
        </p>
      </div>
      <ul class="repos">
        {repos.map((r) => (
          <li>
            <a class="repos__link" href={r.data.repo} rel="noopener noreferrer">
              <Icon name="github" size={18} />
              <span class="repos__name">lyfie-org/{r.id}</span>
              <span class="repos__desc">{r.data.tagline}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow">
      <aside class="card note">
        <p class="eyebrow">A note from the maintainer</p>
        <p>
          I started Lyfie because I was tired of renting my own tools. I lead the project
          and keep its direction coherent, but the best ideas here have come from other
          people — and I want many more of them. If you care about free software that is
          also a joy to use, you are exactly who this is for.
        </p>
        <p class="note__sign">
          —{" "}
          <a href={CREATOR_URL} rel="noopener noreferrer">
            {CREATOR_NAME}
          </a>
          , creator of Lyfie
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .body {
    padding-top: 0;
  }

  .ways {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .way h3 {
    margin: 0;
  }

  .way__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--accent-text);
  }

  .repos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .repos__link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .repos__link:hover {
    border-color: var(--accent-border);
    box-shadow: var(--shadow-card-hover);
    color: var(--text);
  }

  .repos__name {
    font: 500 var(--fs-sm) / 1.3 var(--mono);
    color: var(--text-h);
    overflow-wrap: anywhere;
  }

  .repos__desc {
    grid-column: 2;
    font-size: var(--fs-xs);
  }

  .note p {
    font-size: var(--fs-md);
    line-height: 1.65;
  }

  .note .eyebrow {
    font-size: var(--fs-xs);
  }

  .note__sign {
    color: var(--text-h);
  }
</style>
