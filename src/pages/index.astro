---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FallingFlora from "../components/FallingFlora.astro";
import ChangelogList from "../components/ChangelogList.astro";
import logo from "../assets/logos/lyfie.png";
import {
  CREATOR_NAME,
  CREATOR_URL,
  DESCRIPTION,
  GITHUB_ORG_URL,
  GOOD_FIRST_ISSUES_URL,
  SPONSORS_URL,
  TAGLINE
} from "../data/site";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = projects.filter((p) => p.data.featured);
const licenses = [...new Set(projects.map((p) => p.data.license).filter(Boolean))];

const values = [
  {
    title: "No paywalls",
    body: "Every feature ships to everyone. No pro tier, no seat pricing, no “contact sales”. Free is the product, not the trial."
  },
  {
    title: "Your data, your hardware",
    body: "Plain files, open formats, self-hosting first. If Lyfie disappeared tomorrow, nothing you made with our software would go with it."
  },
  {
    title: "Free doesn’t mean dull",
    body: "Open source has earned a reputation for being grey and fiddly. We sweat the design, the defaults and the docs as much as the code."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Lyfie",
  url: "https://www.lyfie.org",
  logo: "https://www.lyfie.org/android-chrome-512x512.png",
  description: DESCRIPTION,
  sameAs: [GITHUB_ORG_URL, "https://x.com/lyfieapp"],
  founder: { "@type": "Person", name: CREATOR_NAME, url: CREATOR_URL }
};
---

<Base title={`Lyfie — ${TAGLINE}`} description={DESCRIPTION} bareTitle>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <section class="hero">
    <FallingFlora />
    <div class="wrap hero__inner">
      <Image
        class="hero__logo"
        src={logo}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
      />
      <h1>Lyfie</h1>
      <p class="hero__tagline">{TAGLINE}</p>
      <p class="hero__lede">
        We build open-source libraries, apps and games — and give every one of them away.
        No subscriptions, no data harvesting, no lock-in. Just well-made software you can
        read, run and keep.
      </p>
      <div class="hero__actions">
        <a class="btn" href="/projects/">
          Explore projects
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn--ghost" href={GITHUB_ORG_URL} rel="noopener noreferrer">
          <Icon name="github" size={16} />
          lyfie-org on GitHub
        </a>
      </div>
      <p class="hero__note">
        {licenses.join(" & ")} licensed · No paywalls · No trackers
      </p>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <p class="eyebrow">What we build</p>
      <h2>Small tools, made properly</h2>
      <p class="lede section__lede">
        Each project stands on its own, with its own site and docs. Every one is labelled
        honestly — stable means stable.
      </p>

      <div class="grid projects">
        {featured.map((project) => (
          <ProjectCard project={project} withInstall />
        ))}
      </div>

      <p class="projects__more">
        <a href="/projects/">
          See all projects <Icon name="arrow-right" size={14} />
        </a>
      </p>
    </div>
  </section>

  <section class="section values">
    <div class="wrap">
      <p class="eyebrow">Why open source</p>
      <h2>Three promises, in every repo</h2>
      <ol class="values__list">
        {values.map((v, i) => (
          <li class="values__item">
            <span class="values__num">{i + 1}</span>
            <div>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p>
        <a class="btn btn--ghost" href="/manifesto/">
          Read the manifesto
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--top">
      <div>
        <p class="eyebrow">Built in public</p>
        <h2>Shipping, out loud</h2>
        <p>
          Every release, fix and experiment happens in the open on GitHub. Here is what
          landed most recently.
        </p>
        <p>
          <a href="/changelog/">
            Full changelog <Icon name="arrow-right" size={14} />
          </a>
        </p>
      </div>
      <ChangelogList limit={4} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--top">
      <div>
        <p class="eyebrow">Help us build</p>
        <h2>Build the future with like-minded folks</h2>
        <p>
          Lyfie is led by{" "}
          <a href={CREATOR_URL} rel="noopener noreferrer">
            {CREATOR_NAME}
          </a>
          , but it is not a one-person show — and it should not be. Fix a bug, write a
          doc, design a screen, or tell us what hurts.
        </p>
      </div>
      <div class="help__actions">
        <a
          class="card help__action"
          href={GOOD_FIRST_ISSUES_URL}
          rel="noopener noreferrer"
        >
          <span class="card__icon">
            <Icon name="github" size={20} />
          </span>
          <h3>Pick up a good first issue</h3>
          <p>Small, well-scoped tasks across every repo, tagged for newcomers.</p>
        </a>
        <a class="card help__action" href={SPONSORS_URL} rel="noopener noreferrer">
          <span class="card__icon">
            <Icon name="heart" size={20} />
          </span>
          <h3>Sponsor the work</h3>
          <p>Keeps the software free for everyone else. Every contribution helps.</p>
        </a>
        <a class="card help__action" href="/contribute/">
          <span class="card__icon">
            <Icon name="star" size={20} />
          </span>
          <h3>Other ways to help</h3>
          <p>Star a repo, report a bug, share a project with someone who needs it.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap--narrow">
      <aside class="callout">
        <h2>Honestly: we are a small team</h2>
        <p>
          Some of these projects are young, and they say so on the label. We would rather
          ship real software carefully and tell you where the rough edges are than promise
          polish we have not earned yet.
        </p>
        <p>
          The one thing that will not change: it is all open source. Whatever happens, the
          code stays yours to read, fork and keep.
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(var(--space-12), 9vw, 8rem) clamp(var(--space-10), 6vw, 5rem);
    text-align: center;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__logo {
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-5);
    height: auto;
    filter: drop-shadow(0 10px 22px rgba(61, 44, 30, 0.14));
  }

  .hero h1 {
    margin-bottom: var(--space-3);
  }

  .hero__tagline {
    font: 400 var(--fs-xl) / 1.25 var(--heading);
    color: var(--text-h);
    letter-spacing: -0.01em;
    max-width: 22ch;
    margin-bottom: var(--space-5);
  }

  .hero__lede {
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--text);
    max-width: 56ch;
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .hero__note {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-xs);
    color: var(--text);
  }

  .projects {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .projects__more {
    margin: var(--space-6) 0 0;
  }

  .values__list {
    list-style: none;
    margin: var(--space-8) 0 var(--space-8);
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .values__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .values__num {
    min-width: 1ch;
    font: 400 var(--fs-2xl) / 1 var(--heading);
    color: var(--accent-text);
  }

  .values__item p {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .help__actions {
    display: grid;
    gap: var(--space-3);
  }

  .help__action h3 {
    margin: 0;
    font-size: var(--fs-md);
  }

  .help__action {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
  }

  .help__action .card__icon {
    grid-row: span 2;
    margin: 2px 0 0;
  }
</style>
