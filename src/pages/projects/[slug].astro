---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { SITE_URL } from "../../data/site";
import Base from "../../layouts/Base.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Icon from "../../components/Icon.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Clip from "../../components/Clip.astro";
import ClipGallery from "../../components/ClipGallery.astro";
import { MEDIA } from "../../data/media";

export async function getStaticPaths() {
  // Teasers (page: false) have no page; their cards do not link here either.
  const projects = await getCollection("projects", (p) => p.data.page);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);

const [lead, ...clips] = MEDIA[project.id] ?? [];

const siblings = (await getCollection("projects", (s) => s.id !== project.id)).sort(
  (a, b) => a.data.order - b.data.order
);

const pageUrl = `${SITE_URL}/projects/${project.id}/`;
const cover = p.cover
  ? new URL((await getImage({ src: p.cover, width: 1200, format: "webp" })).src, SITE_URL)
      .href
  : undefined;
const org = { "@id": `${SITE_URL}/#organization` };

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": p.type === "library" ? "SoftwareSourceCode" : "SoftwareApplication",
      "@id": `${pageUrl}#software`,
      name: p.name,
      description: p.tagline,
      url: p.site ?? pageUrl,
      mainEntityOfPage: pageUrl,
      ...(cover ? { image: cover, screenshot: cover } : {}),
      ...(p.repo ? { codeRepository: p.repo } : {}),
      ...(p.license ? { license: p.license } : {}),
      ...(p.type === "app"
        ? {
            applicationCategory: "ProductivityApplication",
            operatingSystem: "Linux, macOS, Windows (Docker); any modern browser",
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }
          }
        : { programmingLanguage: "TypeScript", runtimePlatform: "React" }),
      keywords: p.points.join(", "),
      isAccessibleForFree: true,
      author: org,
      publisher: org,
      sameAs: [p.site, p.repo].filter(Boolean)
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Lyfie", item: `${SITE_URL}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: "Projects",
          item: `${SITE_URL}/projects/`
        },
        { "@type": "ListItem", position: 3, name: p.name, item: pageUrl }
      ]
    }
  ]
};
---

<Base
  title={`${p.name} — ${p.tagline.replace(/\.$/, "")}`}
  description={`${p.name} is ${p.tagline.charAt(0).toLowerCase()}${p.tagline.slice(1)} Free and open source${p.license ? ` (${p.license})` : ""}, from Lyfie.`}
  image={p.cover}
  imageAlt={p.coverAlt}
>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`/projects/${project.id}.md`}
    title={`${p.name}, as Markdown`}
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">
        <a href="/projects/">Projects</a> / {p.type}
      </p>
      <div class="head">
        {p.logo && (
          <Image
            class="head__logo"
            src={p.logo}
            alt=""
            width={72}
            height={72}
            densities={[1, 2]}
            loading="eager"
          />
        )}
        <div>
          <h1>{p.name}</h1>
          <p class="lede">{p.tagline}</p>
        </div>
      </div>
      <div class="head__actions">
        {p.site && (
          <a class="btn" href={p.site} rel="noopener noreferrer">
            <Icon name="globe" size={16} />
            Visit {new URL(p.site).hostname.replace(/^www\./, "")}
          </a>
        )}
        {p.repo && (
          <a class="btn btn--ghost" href={p.repo} rel="noopener noreferrer">
            <Icon name="github" size={16} />
            Source
          </a>
        )}
        {p.docs && (
          <a class="btn btn--ghost" href={p.docs} rel="noopener noreferrer">
            <Icon name="book" size={16} />
            Docs
          </a>
        )}
      </div>
      {lead && (
        <div class="lead">
          <Clip
            src={lead.src}
            themed={lead.themed}
            width={lead.width}
            height={lead.height}
            label={lead.label}
            eager
          />
        </div>
      )}
    </div>
  </section>

  <section class="section body">
    <div class="wrap layout">
      <article class="prose">
        <Content />
      </article>

      <aside class="side">
        <dl class="card facts">
          <div>
            <dt>Status</dt>
            <dd>
              <StatusBadge status={p.status} />
            </dd>
          </div>
          <div>
            <dt>Type</dt>
            <dd class="facts__value">{p.type}</dd>
          </div>
          {p.license && (
            <div>
              <dt>License</dt>
              <dd class="facts__value">{p.license}</dd>
            </div>
          )}
        </dl>
        {p.install && (
          <div>
            <p class="eyebrow side__label">Get started</p>
            <CodeBlock code={p.install} label={p.installLabel} lang="bash" />
          </div>
        )}
      </aside>
    </div>
  </section>

  {clips.length > 0 && (
    <section class="section section--tint" id="in-action">
      <div class="wrap">
        <p class="eyebrow">See it in action</p>
        <h2>{p.name}, a few seconds at a time.</h2>
        <div class="in-action">
          <ClipGallery clips={clips} />
        </div>
      </div>
    </section>
  )}

  {siblings.length > 0 && (
    <section class="section more">
      <div class="wrap">
        <p class="eyebrow">Also from Lyfie</p>
        <h2>More, made the same way.</h2>
        <div class="grid more__grid">
          {siblings.map((s) => (
            <ProjectCard project={s} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    text-decoration: underline;
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .head h1 {
    margin-bottom: var(--space-2);
  }

  .head .lede {
    margin: 0;
  }

  .head__logo {
    flex: none;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    height: auto;
  }

  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .body {
    padding-top: 0;
  }

  .lead {
    margin-top: clamp(var(--space-8), 5vw, var(--space-12));
  }

  .in-action {
    margin-top: var(--space-8);
  }

  .more__grid {
    margin-top: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(var(--space-8), 5vw, var(--space-12));
    align-items: start;
  }

  .side {
    display: grid;
    /* Explicit shrinkable track: a long install line must scroll inside its
       code block, not widen the sidebar past the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    position: sticky;
    top: 84px;
    min-width: 0;
  }

  .facts {
    margin: 0;
    gap: 0;
    padding-block: var(--space-2);
  }

  .facts > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .facts > div + div {
    border-top: 1px solid var(--border);
  }

  .facts dt {
    font-size: var(--fs-sm);
    color: var(--text);
  }

  .facts dd {
    margin: 0;
  }

  .facts__value {
    font: 500 var(--fs-sm) / 1 var(--mono);
    color: var(--text-h);
    text-transform: capitalize;
  }

  .side__label {
    margin-bottom: var(--space-2);
  }

  @media (max-width: 56rem) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }

    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: static;
      order: -1;
    }
  }
</style>
