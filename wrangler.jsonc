{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lyfie-org",
  "compatibility_date": "2026-03-12",
  "workers_dev": true,
  "preview_urls": true,
  // Static assets only: Astro prebuilds every page into dist/. Unknown paths get
  // dist/404.html with a real 404 status. public/_headers is honoured as-is.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
